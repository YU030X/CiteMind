# CiteMind API 基础配置。
CITEMIND_ENVIRONMENT=development
# 指向 deploy/compose/compose.yml 暴露的本机端口，使用非特权的 api 运行角色。
CITEMIND_DATABASE_URL=postgresql+psycopg://citemind_api:citemind@127.0.0.1:55432/citemind

# 以下是 deploy/compose/compose.yml 需要的变量，仅供本机开发数据服务使用。
# 根 .env 已存在时不要用本文件覆盖它，只把下面需要的变量追加进去，避免丢掉已有的密钥。
# 这些密码是开发占位值；initdb 脚本把它们写入对应角色，生产环境必须换成独立密钥。
CITEMIND_MIGRATION_DB_PASSWORD=citemind
CITEMIND_API_DB_PASSWORD=citemind
CITEMIND_WORKER_DB_PASSWORD=citemind
CITEMIND_REDIS_PASSWORD=citemind

# worker 连接本机 Redis 的带认证 broker URL；缺失时 worker 启动直接失败，不会回退到 localhost。
CITEMIND_REDIS_URL=redis://:citemind@127.0.0.1:56379/0

# 可选：覆盖默认的宿主端口；两者都只绑定 127.0.0.1。
CITEMIND_POSTGRES_PORT=55432
CITEMIND_REDIS_PORT=56379

# 仅供 Alembic 在线迁移使用，需要更高权限（CREATE EXTENSION）；只用于迁移进程，
# 不进入 API/worker 运行配置。在线迁移缺少它时会直接失败，不会回退到 CITEMIND_DATABASE_URL。
# CITEMIND_MIGRATION_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind

# 仅供专用 PostgreSQL/pgvector 集成测试使用；数据库名必须以 _test 结尾。
# CITEMIND_TEST_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind_test

# 集成测试会 upgrade 并 downgrade 该测试库，必须显式确认才允许运行。
# CITEMIND_ALLOW_DESTRUCTIVE_TEST_DB=1

# 角色权限测试只读，但会以三个运行角色连接；三个 DSN 必须同时提供且指向同一个 _test 库。
# CITEMIND_TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind_test
# CITEMIND_TEST_API_DATABASE_URL=postgresql+psycopg://citemind_api:citemind@127.0.0.1:55432/citemind_test
# CITEMIND_TEST_WORKER_DATABASE_URL=postgresql+psycopg://citemind_worker:citemind@127.0.0.1:55432/citemind_test

# broker 集成测试会启动独立 worker，并使用同一个 Redis 的非 0 逻辑库；必须显式 opt-in。
# CITEMIND_TEST_REDIS_URL=redis://:citemind@127.0.0.1:56379/15
# CITEMIND_ALLOW_TEST_REDIS=1
