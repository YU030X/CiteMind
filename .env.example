# CiteMind API 基础配置。
CITEMIND_ENVIRONMENT=development
CITEMIND_DATABASE_URL=postgresql+psycopg://citemind:citemind@localhost:5432/citemind

# 仅供 Alembic 在线迁移使用，需要更高权限（CREATE EXTENSION）；只用于迁移进程，
# 不进入 API/worker 运行配置。在线迁移缺少它时会直接失败，不会回退到 CITEMIND_DATABASE_URL。
# CITEMIND_MIGRATION_DATABASE_URL=postgresql+psycopg://citemind_migrator:change-me@localhost:5432/citemind

# 仅供专用 PostgreSQL/pgvector 集成测试使用；数据库名必须以 _test 结尾。
# CITEMIND_TEST_DATABASE_URL=postgresql+psycopg://citemind:citemind@localhost:5432/citemind_test

# 集成测试会 upgrade 并 downgrade 该测试库，必须显式确认才允许运行。
# CITEMIND_ALLOW_DESTRUCTIVE_TEST_DB=1

# 仅供开发期 Jev 判断脚本使用，不得加 VITE_ 前缀。
# AI_GATEWAY_API_KEY=
