# 仅供本机开发；已有 .env 时请保留原有密钥，不要直接用本文件覆盖。
# 进程环境优先于 .env；运行前检查 DATABASE_URL、LLM_API_KEY 等同名裸变量。
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://citemind_api:citemind@127.0.0.1:55432/citemind

# 生产环境须设置独立 CSRF_SECRET、HTTPS 来源及可信代理，保持安全 Cookie 开启。
# ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# CSRF_SECRET=
# SESSION_COOKIE_SECURE=1
# ALLOWED_ORIGINS=http://127.0.0.1:58080,http://localhost:58080
# SESSION_TTL_SECONDS=43200
# 仅信任来自指定 CIDR 的代理头；空值表示不信任代理。
# TRUSTED_PROXY_CIDRS=172.28.10.0/24
# CLIENT_IP_HEADER=X-Real-IP
# 未配置 REDIS_URL 时登录返回 503。
# LOGIN_RATE_LIMIT_PER_IP=20
# LOGIN_RATE_LIMIT_PER_USERNAME=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# 以下密码仅为开发占位值，生产环境必须替换。
MIGRATION_DB_PASSWORD=citemind
API_DB_PASSWORD=citemind
WORKER_DB_PASSWORD=citemind
REDIS_PASSWORD=citemind

REDIS_URL=redis://:citemind@127.0.0.1:56379/0

# outbox dispatcher 由 API 进程 lifespan 按配置承载；宿主进程默认关闭，Compose 的 api 服务已显式设为 true，本地不想启用时保持注释即可。
# DISPATCHER_ENABLED=1

# 本机端口；仅网关对外提供应用入口。
POSTGRES_PORT=55432
REDIS_PORT=56379
GATEWAY_PORT=58080

# 可选：api 上传原文件存储根；默认 /var/lib/citemind/documents（Compose 内为 api 私有卷）。
# DOCUMENT_STORAGE_DIRECTORY=/var/lib/citemind/documents

# 开发用 INFERENCE_TOKEN；生产环境必须替换，切勿写入日志。
INFERENCE_TOKEN=citemind-inference
EMBEDDING_TORCH_THREADS=2

# 收费探针默认关闭；同时设置 ALLOW_LLM_PROBE=1 和 LLM_API_KEY 才会请求 DeepSeek。
# LLM_API_KEY 不复用 AI_GATEWAY_API_KEY；可由运行环境安全注入，切勿回显。
LLM_MODEL=deepseek-flash
# ALLOW_LLM_PROBE=1
# LLM_API_KEY=

# 在线迁移专用高权限 DSN；缺失时不会回退到 DATABASE_URL。
# MIGRATION_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind

# 集成测试只可使用 _test 数据库；升级和回退须显式授权。
# TEST_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind_test

# ALLOW_DESTRUCTIVE_TEST_DB=1

# 角色权限测试需同时设置三个指向同一 _test 库的 DSN。
# TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://citemind_migrator:citemind@127.0.0.1:55432/citemind_test
# TEST_API_DATABASE_URL=postgresql+psycopg://citemind_api:citemind@127.0.0.1:55432/citemind_test
# TEST_WORKER_DATABASE_URL=postgresql+psycopg://citemind_worker:citemind@127.0.0.1:55432/citemind_test

# Redis 集成测试使用非 0 逻辑库，并须显式授权。
# TEST_REDIS_URL=redis://:citemind@127.0.0.1:56379/15
# ALLOW_TEST_REDIS=1
